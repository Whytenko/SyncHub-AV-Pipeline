# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# PostgreSQL connection string.
# Local dev default (used if unset): postgresql://localhost/synchub_dev
# Production: paste the managed-DB URL (Render/Supabase/Neon/Heroku).
# DATABASE_URL=postgresql://user:password@host:5432/synchub

# SSL for the DB connection.
#   unset → auto: off in development, on in production
#   true  → force on  (managed Postgres usually needs this)
#   false → force off (local Postgres)
# DATABASE_SSL=true

# Comma-separated list of allowed frontend origins for CORS.
# In production set this to your deployed client URL, e.g. https://synchub-web.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload size limits (megabytes)
UPLOAD_MAX_MB=500
UPLOAD_DOC_MAX_MB=100

# ─── Object storage (optional) ──────────────────────────────────────────────────
# Cover images go through a storage abstraction (server/src/storage.js).
# Unset → files saved to server/public/uploads (needs a persistent disk in prod).
# Set S3_BUCKET to use any S3-compatible bucket (AWS S3 / Cloudflare R2 / MinIO).
# Requires: npm i @aws-sdk/client-s3
# S3_BUCKET=synchub-assets
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   # for R2/MinIO
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_URL=https://cdn.example.com                       # public base for stored objects
# S3_FORCE_PATH_STYLE=false

# ─── Client (Vite) ────────────────────────────────────────────────────────────
# The API base URL. Inlined into the build at compile time.
# Dev default (used if unset): http://localhost:5001
# VITE_API_URL=http://localhost:5001
